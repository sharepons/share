# ⛔⛔ THE DOMAIN AND THE MARK ARE DELIBERATELY BLANK until they are chosen. Nothing here invents a
# placeholder: a guessed domain ends up in an og:url and in a token's own metadata, which has no
# setter on Pons V2 and is therefore permanent.

# The launchpad and the vault, from contracts/deploy.sh. Left empty, the site renders honestly —
# the feed says the launchpad is not deployed rather than showing a zero that reads as "no launches".
VITE_LAUNCHPAD=
VITE_CLAIMS=

# This site's own token, once it has one. Until then the strip reads "CA: TBA".
VITE_TOKEN_CA=

# ⚠ Only set once a real domain exists. It is what every absolute URL is built from.
VITE_SITE_URL=
# ⛔ Leave empty until the handle is registered. An unregistered handle is a link to nothing.
VITE_X_URL=
# ⚠ The REPO, not the account — the footer icon is a link to the source, so a bare org page is a
# dead end for anyone who clicks it wanting the code.
VITE_GITHUB_URL=

# Set to 1 after dropping public/logo.png in. Until then the header draws the split-bar mark.
VITE_HAS_LOGO=

# Optional. Defaults to the public RPC.
VITE_RHC_RPC=
