# SHARE server. Copy to .env. ⛔ Nothing here is read from the front end — this file never ships.

# ⛔⛔ EVERY OAUTH CALLBACK IS REGISTERED AGAINST ONE EXACT URL BUILT FROM THIS. Wrong here means the
# provider refuses the redirect and names the app rather than the setting.
# ⚠ The domain is real as of 4 Sep 2026. Register the three callbacks against exactly:
#     https://sharepons.family/api/auth/callback/x
#     https://sharepons.family/api/auth/callback/github
#     https://sharepons.family/api/auth/callback/instagram   (and /tiktok)
PUBLIC_URL=https://sharepons.family
PORT=5234
DATA_DIR=/root/share-data

# ── the claim path ───────────────────────────────────────────────────────────────────────────────
# ⛔ Robinhood Chain. Part of the EIP-712 domain: wrong and every signature verifies nowhere.
CHAIN_ID=4663
# The deployed ShareClaims. Printed by contracts/deploy.sh.
CLAIMS_ADDRESS=
# ⛔⛔ The attestation key. It can only ever say who somebody is — it cannot move money, cannot
# decide an amount and cannot change a split. `npm run signer:address` prints the address this must
# be set to in the vault's constructor. NEVER the same key as the vault's owner.
ATTESTATION_KEY=
ATTESTATION_TTL=900

# ⭐⭐ AFTER FILLING THE TWO ABOVE IN, RUN `npm run preflight`. It is the only thing that compares
# what was typed here against the deployed contracts — including whether this key is actually the
# vault's signer. Get that wrong and social claims revert as bad signatures while wallet claims,
# sign-in, the feed and /api/health all keep looking perfectly healthy.

# ── signing in ───────────────────────────────────────────────────────────────────────────────────
# A platform with no credentials here simply does not appear in the sign-in list.
# ⛔ Callback to register: ${PUBLIC_URL}/api/auth/callback/x
X_CLIENT_ID=
X_CLIENT_SECRET=
# ⚠ SEPARATE from the OAuth pair, and prepaid per lookup against a balance held PER PROJECT — a new
# app in a fresh project starts at zero even though an older app on the same login works. Without it
# handles cannot be resolved and the launch form says so.
X_BEARER_TOKEN=

# ⭐ A twitterapi.io key, used INSTEAD of X_BEARER_TOKEN for resolving @handles when it is set.
#   X's own lookup is prepaid per call against a balance held per developer PROJECT and a fresh
#   project starts at zero, so a deployment can sign people in perfectly while every lookup answers
#   402. twitterapi.io is a separate, cheaper balance.
# ⛔ NOT a fallback chain: set this and X's own endpoint is not tried at all. Fund whichever one you
#   configure — a lookup that quietly spends from the other balance is worse than a clear error.
# ⚠ The same credential is called TWITTERAPI_IO_KEY in a sibling project's launcher.
X_LOOKUP_KEY=

# ⛔ It must be an OAuth App, not a GitHub App — same settings page, entirely different flow.
#    Callback: ${PUBLIC_URL}/api/auth/callback/github
# ⭐ GitHub handle LOOKUP needs no credential at all, so GitHub recipients can be named on a launch
#    even before this is filled in. Only their claim needs it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ⚠ "Instagram API with Instagram Login" (the Basic Display API was shut down in December 2024).
#    Callback: ${PUBLIC_URL}/api/auth/callback/instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ⚠ TikTok calls it a client KEY, on both the authorize URL and the token exchange.
#    Callback: ${PUBLIC_URL}/api/auth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── token logos ──────────────────────────────────────────────────────────────────────────────────
# ⛔⛔ OUTSIDE the site's deploy root. A front end deployed with `rsync --delete` would take every
# token's logo with it, and the URL is in the token's constructor with no setter — permanently.
LOGO_DIR=/root/share-logos
LOGO_PUBLIC_BASE=https://sharepons.family/logos
